#: inc/customizer/customizer.php:383
msgid "Максимальная ширина сайта"
msgstr "Maximum site width"

#: inc/customizer/customizer.php:391
msgid "Собственное значение"
msgstr "Custom value"

#: inc/customizer/customizer.php:392
msgid "Во всю ширину экрана"
msgstr "Full screen width"

#: inc/customizer/customizer.php:402
msgid "Своя ширина, px"
msgstr "Custom width, px"

#: inc/customizer/customizer.php:417
msgid "«Прилипающая» боковая колонка"
